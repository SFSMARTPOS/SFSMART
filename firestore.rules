// SF SMART POS central database rules.
// This build uses Firebase Anonymous Authentication as a basic gate.
// Enable Authentication -> Sign-in method -> Anonymous in Firebase Console.
// For stronger per-user security, migrate the existing custom users to
// Firebase Authentication before production use.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sfCentralData/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
